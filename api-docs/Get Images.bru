meta {
  name: Get Images
  type: http
  seq: 4
}

get {
  url: {{base_url}}/images?user_id=1&category=city
  body: none
  auth: inherit
}

params:query {
  user_id: 1
  category: city
}

settings {
  encodeUrl: true
  timeout: 0
}

